{
  "name": "unicourse-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest --exclude \"e2e/**\" --exclude \"node_modules/**\" --exclude \"dist/**\"",
    "generate": "openapi-typescript ../api/openapi.json -o src/api/types.ts",
    "postman": "node scripts/postman.mjs ../api/openapi.json ../../docs/postman/unicourse.postman_collection.json",
    "two-origin-check": "node scripts/two-origin-check.mjs",
    "e2e": "playwright test --project=chromium",
    "screens": "playwright test --project=screens"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "lucide-react": "^1.52.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "openapi-to-postmanv2": "6.4.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
